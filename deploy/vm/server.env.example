# =============================================================================
# server.env — Config del Coder server (login por OIDC de GitLab)  [rama gitlab]
# =============================================================================
# Copia a ~/.config/coderv2/server.env en la VM (chmod 600) y rellena.
# Formato: `export VAR=valor` (lo hace `source` start-server.sh). CONTIENE
# SECRETOS → nunca lo subas a git (cubierto por .gitignore).
#
# Modelo GitLab: login por OIDC + RBAC por GRUPOS de GitLab (claim de grupos) +
# external-auth tipo gitlab (repos per-usuario). SIN GitHub App ni resolver.
# -----------------------------------------------------------------------------

# --- Red / URL --------------------------------------------------------------
export CODER_ACCESS_URL="http://CHANGE_ME:3000"
export CODER_HTTP_ADDRESS="0.0.0.0:3000"
# Solo con dominio (apps subdominio): export CODER_WILDCARD_ACCESS_URL="*.coder.tu-empresa.com"

# --- Login: OIDC de GitLab (AuthN + grupos para RBAC) -----------------------
# Crea una OAuth App en GitLab:
#   - De grupo:   https://gitlab.com/groups/<tu-grupo>/-/settings/applications
#   - O de usuario: https://gitlab.com/-/profile/applications
#   Redirect URI: <CODER_ACCESS_URL>/api/v2/users/oidc/callback
#   Scopes:       openid, profile, email   (marca "Confidential")
export CODER_OIDC_ISSUER_URL="https://gitlab.com"
export CODER_OIDC_CLIENT_ID="CHANGE_ME"
export CODER_OIDC_CLIENT_SECRET="CHANGE_ME"
export CODER_OIDC_SCOPES="openid,profile,email"
export CODER_OIDC_SIGN_IN_TEXT="Entrar con GitLab"

# Grupos → RBAC: GitLab entrega los grupos del usuario en el claim `groups_direct`
# (rutas completas de los grupos donde es miembro directo). Coder los sincroniza
# como grupos de Coder; la plantilla mapea grupo→rol (variables group_qa/…).
export CODER_OIDC_GROUP_FIELD="groups_direct"
# (opcional) Restringe el acceso SOLO a miembros de estos grupos (fail-closed):
# export CODER_OIDC_ALLOWED_GROUPS="coder-qintess"
# (opcional) Normaliza nombres si tus grupos vienen como "grupo/subgrupo":
# export CODER_OIDC_GROUP_MAPPING='{"coder-qintess/platform-developers":"platform-developers","coder-qintess/qa-engineers":"qa-engineers","coder-qintess/architects":"architects"}'

# --- external-auth #0: GitLab per-usuario (repos del operador) ---------------
# OAuth App de GitLab (puede ser la misma del login si el redirect cubre la raíz,
# o una aparte). Callback: <CODER_ACCESS_URL>/external-auth/gitlab/callback
# Scopes recomendados: api  (o read_api+write_repository según necesites).
export CODER_EXTERNAL_AUTH_0_ID="gitlab"
export CODER_EXTERNAL_AUTH_0_TYPE="gitlab"
export CODER_EXTERNAL_AUTH_0_CLIENT_ID="CHANGE_ME"
export CODER_EXTERNAL_AUTH_0_CLIENT_SECRET="CHANGE_ME"

# --- external-auth #1: Atlassian/Jira OAuth 3LO (per-usuario) ----------------
# Independiente de GitLab. OJO: Atlassian exige callback HTTPS (no http/IP).
# App en https://developer.atlassian.com/console/myapps/
# Callback: <CODER_ACCESS_URL>/external-auth/atlassian/callback
export CODER_EXTERNAL_AUTH_1_ID="atlassian"
export CODER_EXTERNAL_AUTH_1_TYPE="atlassian"
export CODER_EXTERNAL_AUTH_1_DISPLAY_NAME="Atlassian (Jira/Confluence)"
export CODER_EXTERNAL_AUTH_1_CLIENT_ID="CHANGE_ME"
export CODER_EXTERNAL_AUTH_1_CLIENT_SECRET="CHANGE_ME"
export CODER_EXTERNAL_AUTH_1_AUTH_URL="https://auth.atlassian.com/authorize?audience=api.atlassian.com&prompt=consent"
export CODER_EXTERNAL_AUTH_1_TOKEN_URL="https://auth.atlassian.com/oauth/token"
export CODER_EXTERNAL_AUTH_1_SCOPES="read:jira-work write:jira-work read:jira-user read:confluence-content.all write:confluence-content read:confluence-space.summary offline_access"

# --- NOTA -------------------------------------------------------------------
# El modelo GitLab NO usa GitHub App ni GITHUB_TOKEN. El rol sale de los grupos
# OIDC (arriba) y lo resuelve la plantilla (templates/mvp-embedded/main.tf).
