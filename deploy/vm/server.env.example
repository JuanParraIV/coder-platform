# =============================================================================
# server.env — Config del Coder server (login GitHub OAuth, mvp-embedded)
# =============================================================================
# Copia a ~/.config/coderv2/server.env en la VM (chmod 600) y rellena.
# Formato: `export VAR=valor` (lo hace `source` start-server.sh). CONTIENE
# SECRETOS → nunca lo subas a git (ya está cubierto por .gitignore).
#
# Este es el modelo del homelab: login por GitHub OAuth + 2 external-auth
# (github per-usuario, atlassian OAuth) + GitHub App para resolver el rol RBAC.
# -----------------------------------------------------------------------------

# --- Red / URL --------------------------------------------------------------
# DEBEN COINCIDIR con vm-deploy.conf. El ACCESS_URL define los redirect URIs.
export CODER_ACCESS_URL="http://CHANGE_ME:3000"
export CODER_HTTP_ADDRESS="0.0.0.0:3000"
# Solo Fase 2 (dominio): descomenta para apps subdominio.
# export CODER_WILDCARD_ACCESS_URL="*.coder.tu-empresa.com"

# --- Login: GitHub OAuth App (AuthN) ----------------------------------------
# Crea una OAuth App en: https://github.com/settings/developers (o de la Org)
#   Homepage URL:              <CODER_ACCESS_URL>
#   Authorization callback URL: <CODER_ACCESS_URL>/api/v2/users/oauth2/github/callback
export CODER_OAUTH2_GITHUB_CLIENT_ID="CHANGE_ME"
export CODER_OAUTH2_GITHUB_CLIENT_SECRET="CHANGE_ME"
# Solo miembros de esta(s) org(s) pueden entrar (fail-closed).
export CODER_OAUTH2_GITHUB_ALLOWED_ORGS="tu-org-github"
export CODER_OAUTH2_GITHUB_ALLOW_SIGNUPS="true"

# --- external-auth #0: GitHub per-usuario (repos del operador) ---------------
# OAuth App aparte (o la misma). Callback:
#   <CODER_ACCESS_URL>/external-auth/github/callback
export CODER_EXTERNAL_AUTH_0_ID="github"
export CODER_EXTERNAL_AUTH_0_TYPE="github"
export CODER_EXTERNAL_AUTH_0_CLIENT_ID="CHANGE_ME"
export CODER_EXTERNAL_AUTH_0_CLIENT_SECRET="CHANGE_ME"

# --- external-auth #1: Atlassian/Jira OAuth 3LO (per-usuario) ----------------
# OAuth 2.0 app en https://developer.atlassian.com/console/myapps/
# Callback: <CODER_ACCESS_URL>/external-auth/atlassian/callback
# Scopes: incluye offline_access (refresh) + los de Jira/Confluence que uses.
export CODER_EXTERNAL_AUTH_1_ID="atlassian"
export CODER_EXTERNAL_AUTH_1_TYPE="atlassian"
export CODER_EXTERNAL_AUTH_1_DISPLAY_NAME="Atlassian (Jira/Confluence)"
export CODER_EXTERNAL_AUTH_1_CLIENT_ID="CHANGE_ME"
export CODER_EXTERNAL_AUTH_1_CLIENT_SECRET="CHANGE_ME"
export CODER_EXTERNAL_AUTH_1_AUTH_URL="https://auth.atlassian.com/authorize?audience=api.atlassian.com&prompt=consent"
export CODER_EXTERNAL_AUTH_1_TOKEN_URL="https://auth.atlassian.com/oauth/token"
export CODER_EXTERNAL_AUTH_1_SCOPES="read:jira-work write:jira-work read:jira-user read:confluence-content.all write:confluence-content read:confluence-space.summary offline_access"

# --- GitHub App: resolver de rol RBAC (AuthZ, Members:read) ------------------
# GitHub App "coder-rbac-resolver". Copia su private key a la VM y apunta la ruta.
export GITHUB_APP_ID="CHANGE_ME"
export GITHUB_APP_INSTALLATION_ID="CHANGE_ME"
export GITHUB_APP_PRIVATE_KEY_PATH="${HOME}/.config/coderv2/github-app.pem"

# --- (Opcional) PAT para resolver rol en builds tempranos --------------------
# Si el keyring no está disponible al arrancar, resolve-role.sh usa este PAT.
# Scope mínimo: read:org. Sin él, builds nuevos caen a rol "unknown".
# export GITHUB_TOKEN="ghp_CHANGE_ME"
