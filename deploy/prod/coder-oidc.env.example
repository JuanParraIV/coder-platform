# =============================================================================
# Coder server — configuración de PRODUCCIÓN: OIDC + GROUP SYNC (Nivel 3 AuthZ)
# -----------------------------------------------------------------------------
# Copia a un secret/EnvironmentFile del server (NO commitear con valores reales).
# Reemplaza el modelo homelab (GitHub OAuth + resolve-role.sh + PAT) por SSO
# corporativo con sincronización de grupos → roles hecha por Coder en el login.
#
# Docs: docs/RUNBOOK-prod-oidc.md · docs/TO-BE/13-authz-a-escala.md
# =============================================================================

# --- OIDC / SSO (Okta, Entra ID/Azure AD, Keycloak, Auth0, ...) --------------
CODER_OIDC_ISSUER_URL="https://<tu-idp>/"            # ej. https://login.microsoftonline.com/<tenant>/v2.0
CODER_OIDC_CLIENT_ID="<client-id>"
CODER_OIDC_CLIENT_SECRET="<client-secret>"           # inyectar vía secret manager
CODER_OIDC_SCOPES="openid,profile,email,groups"      # el scope/claim de grupos varía por IdP
CODER_OIDC_EMAIL_DOMAIN="tu-banco.com"               # restringe altas a dominios corporativos
CODER_OIDC_SIGN_IN_TEXT="Iniciar sesión con SSO corporativo"

# --- GROUP SYNC: grupos del IdP → grupos de Coder ----------------------------
# El claim que trae los grupos (Okta: "groups"; Entra: "groups" o "roles").
CODER_OIDC_GROUP_FIELD="groups"
# (Opcional) Solo dejar entrar si pertenece a estos grupos del IdP:
# CODER_OIDC_GROUP_ALLOW_LIST="architects,platform-developers,qa-engineers"
# Mapeo explícito grupo-del-IdP → grupo-de-Coder (JSON). Los slugs de la
# derecha son los que lee el template en data.coder_workspace_owner.me.groups.
CODER_OIDC_GROUP_MAPPING='{"<idp-group-id-arch>":"architects","<idp-group-id-dev>":"platform-developers","<idp-group-id-qa>":"qa-engineers"}'
# Auto-crear en Coder los grupos que lleguen por el claim (requiere Premium):
CODER_OIDC_GROUP_AUTO_CREATE="true"
# (Opcional, Premium) filtrar grupos por regex antes de mapear:
# CODER_OIDC_GROUP_REGEX_FILTER="^(architects|platform-developers|qa-engineers)$"

# --- ROLE SYNC (opcional): claim del IdP → roles de sitio de Coder -----------
# Para asignar roles de PLATAFORMA (owner/auditor/...) desde el IdP, no solo
# grupos. El rol de NEGOCIO (developer/qa/architect) lo deriva el template
# desde los grupos; esto es para permisos administrativos de Coder. (Premium)
# CODER_OIDC_USER_ROLE_FIELD="roles"
# CODER_OIDC_USER_ROLE_MAPPING='{"platform-admins":["owner"],"security-auditors":["auditor"]}'

# --- SCIM (opcional, Premium): provisioning/deprovisioning automático --------
# Alta y BAJA de usuarios desde el IdP sin admin. Clave para regulado (bajas).
# CODER_SCIM_API_KEY="<scim-token>"

# --- GitHub external-auth (git del usuario dentro del workspace) -------------
# OJO: esto es para que `gh`/git del usuario funcione en su workspace. NO se
# usa para resolver el rol (eso lo hace el group sync de arriba).
CODER_EXTERNAL_AUTH_0_ID="github"
CODER_EXTERNAL_AUTH_0_TYPE="github"
CODER_EXTERNAL_AUTH_0_CLIENT_ID="<gh-oauth-client-id>"
CODER_EXTERNAL_AUTH_0_CLIENT_SECRET="<gh-oauth-client-secret>"

# --- Acceso / red ------------------------------------------------------------
CODER_ACCESS_URL="https://coder.tu-banco.com"
CODER_HTTP_ADDRESS="0.0.0.0:3000"
CODER_WILDCARD_ACCESS_URL="*.coder.tu-banco.com"   # necesario para apps subdomain

# =============================================================================
# NOTA DE ESCALA: con esto NINGÚN usuario pega tokens. Hacen SSO y Coder les
# asigna grupos → el template deriva el rol. El único "token" (external-auth de
# GitHub) es OAuth por usuario y solo para su git, gestionado por Coder.
# =============================================================================
