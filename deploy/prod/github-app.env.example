# =============================================================================
# GitHub App — credencial de AuthZ de la ORGANIZACIÓN (Nivel 2, Camino A)
# -----------------------------------------------------------------------------
# Reemplaza el PAT personal del homelab por una App de la org: token de
# instalación auto-rotado (~1 h), no atado a ninguna persona, auditable.
# `resolve-role.sh` mintéa el token on-demand con `gh-app-token.sh`.
#
# Cómo se obtienen estos valores → docs/RUNBOOK-github-app.md
# Cargar en el ENTORNO del `coder server` (append a ~/.config/coderv2/server.env,
# perm 600, git-ignored). NO commitear con valores reales.
# =============================================================================

# App ID (Settings → Developer settings → GitHub Apps → tu App → "App ID")
export GITHUB_APP_ID="123456"

# Installation ID (tras instalar la App en la org; ver runbook para obtenerlo)
export GITHUB_APP_INSTALLATION_ID="87654321"

# Private key: ruta a un .pem con perm 600 (preferido) …
export GITHUB_APP_PRIVATE_KEY_PATH="/home/jotamario/.config/coderv2/github-app.pem"
# … o inline (alternativa; menos limpio). Solo una de las dos.
# export GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
# ...
# -----END RSA PRIVATE KEY-----"

# NOTA: con esto NO va ningún GITHUB_TOKEN=<PAT> personal en server.env.
# Precedencia en resolve-role.sh: PAT en entorno > GitHub App > gh ambiente.
# Si dejas ambos, el PAT gana (útil para migrar sin romper).
